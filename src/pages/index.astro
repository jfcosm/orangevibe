---
// Redirect to localized path based on user preference
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>OrangeVibe</title>
    <meta http-equiv="refresh" content="0;url=/es/" />
    <script is:inline>
      // Detect browser language and redirect to the corresponding subpath
      const language = navigator.language || navigator.userLanguage;
      if (language && language.toLowerCase().startsWith('en')) {
        window.location.href = '/en/';
      } else {
        window.location.href = '/es/';
      }
    </script>
  </head>
  <body>
    <p>Redirecting to / Redirigiendo a <a href="/es/">Español</a> / <a href="/en/">English</a>...</p>
  </body>
</html>
