---
interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id } = Astro.props;
---

<div 
  id={id}
  class={`relative bg-white/20 backdrop-blur-lg border border-white/40 rounded-3xl shadow-[0_8px_32px_0_rgba(234,88,12,0.15)] overflow-hidden transition-all duration-300 hover:bg-white/25 ${className}`}
>
  <!-- Absolute inset div for inner 3D plastic highlight -->
  <div class="absolute inset-0 shadow-[inset_0_2px_4px_0_rgba(255,255,255,0.6)] pointer-events-none rounded-3xl"></div>
  
  <!-- Outer orange gloss overlay highlight at the top border (gradient shine) -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></div>

  <slot />
</div>
